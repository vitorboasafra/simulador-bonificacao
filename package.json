  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "cfb": "^1.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0",
    "xlsx": "^0.18.5"
  }
}
