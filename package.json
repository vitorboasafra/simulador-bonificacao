{
  "name": "simulador-bonificacao-login",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "start": "node server.js",
    "restart": "npm.cmd start",
